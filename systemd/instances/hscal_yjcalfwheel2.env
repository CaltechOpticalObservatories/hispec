# HISPEC CAL BLUE FilterWheel2 — Thorlabs FW102C controller instance (hscal)
#
#   hispec deploy hscal_yjcalfwheel2
#
# copies this file to /etc/hispec/instances/hscal_yjcalfwheel2.env and
# config/hscal/hscal_yjcalfwheel2.yaml to
# /etc/hispec/hscal_yjcalfwheel2.yaml, then enables and starts the daemon.
HISPEC_DAEMON=generic/filterwheel
HISPEC_CONFIG=/etc/hispec/hscal_yjcalfwheel2.yaml
HISPEC_HOST=hispecserver

# HISPEC CAL GREY UNIT FilterWheel — Thorlabs FW102C controller instance (hscal)
#
#   hispec deploy hscal_hkgcellfwheel
#
# copies this file to /etc/hispec/instances/hscal_hkgcellfwheel.env and
# config/hscal/hscal_hkgcellfwheel.yaml to
# /etc/hispec/hscal_hkgcellfwheel.yaml, then enables and starts the daemon.
HISPEC_DAEMON=generic/filterwheel
HISPEC_CONFIG=/etc/hispec/hscal_hkgcellfwheel.yaml
HISPEC_HOST=hispecserver

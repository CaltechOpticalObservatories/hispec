# HISPEC CAL GREY UNIT FilterWheel — Thorlabs FW102C controller instance (hscal)
#
# systemctl enable --now hispec-daemon@hscal_hkgcellfwheel
#
# Deploy the config alongside this file:
#   config/hscal/hscal_hkgcellfwheel.yaml -> /etc/hispec/hscal_hkgcellfwheel.yaml
HISPEC_DAEMON=generic/filterwheel
HISPEC_CONFIG=/etc/hispec/hscal_hkgcellfwheel.yaml

# ATC Focal/Pupil Plane Selector, C-663 stepper instance (hsfei)
#
#   hispec deploy hsfei_atcl
#
# copies this file to /etc/hispec/instances/hsfei_atcl.env and
# config/hsfei/hsfei_atcl.yaml to /etc/hispec/hsfei_atcl.yaml, then enables
# and starts the daemon.
HISPEC_DAEMON=hsfei/pi-daemon
HISPEC_CONFIG=/etc/hispec/hsfei_atcl.yaml
HISPEC_HOST=hispecserver

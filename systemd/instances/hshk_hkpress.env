# HKPress — Inficon VGC502 pressure gauge (hshk)
#
#   hispec deploy hshk_hkpress
#
# copies this file to /etc/hispec/instances/hshk_hkpress.env and
# config/hshk/hshk_hkpress.yaml to /etc/hispec/hshk_hkpress.yaml, then
# enables and starts the daemon.
HISPEC_DAEMON=generic/inficon
HISPEC_CONFIG=/etc/hispec/hshk_hkpress.yaml
HISPEC_HOST=hispecserver

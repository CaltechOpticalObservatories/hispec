# HKPress — Inficon VGC502 pressure gauge (hshk)
#
# systemctl enable --now hispec-daemon@hshk_hkpress
#
# Deploy the config alongside this file:
#   config/hshk/hshk_hkpress.yaml -> /etc/hispec/hshk_hkpress.yaml
HISPEC_DAEMON=generic/inficon
HISPEC_CONFIG=/etc/hispec/hshk_hkpress.yaml
HISPEC_HOST=hispecserver

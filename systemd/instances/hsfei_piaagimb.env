# PIAA Gimbal Mount B, PPC102 piezo controller, axis 2 (hsfei)
#
# systemctl enable --now hispec-daemon@hsfei_piaagimb
#
# Deploy the config alongside this file:
#   config/hsfei/hsfei_piaagimb.yaml -> /etc/hispec/hsfei_piaagimb.yaml
HISPEC_DAEMON=hsfei/piaa-gimbalmount
HISPEC_CONFIG=/etc/hispec/hsfei_piaagimb.yaml

# PIAA Gimbal Mount B, PPC102 piezo controller, axis 2 (hsfei)
#
#   hispec deploy hsfei_piaagimb
#
# copies this file to /etc/hispec/instances/hsfei_piaagimb.env and
# config/hsfei/hsfei_piaagimb.yaml to /etc/hispec/hsfei_piaagimb.yaml, then
# enables and starts the daemon.
HISPEC_DAEMON=hsfei/piaa-gimbalmount
HISPEC_CONFIG=/etc/hispec/hsfei_piaagimb.yaml
HISPEC_HOST=hispecserver

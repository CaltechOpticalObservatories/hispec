# HISPEC BLUE CAL Etalon Attenuator — OZOptics DD100MC controller instance (hscal)
#
#   hispec deploy hscal_yjetatten
#
# copies this file to /etc/hispec/instances/hscal_yjetatten.env and
# config/hscal/hscal_yjetatten.yaml to /etc/hispec/hscal_yjetatten.yaml, then
# enables and starts the daemon.
HISPEC_DAEMON=hscal/ozopt_attenuator
HISPEC_HOST=hispecserver

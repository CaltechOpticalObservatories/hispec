# HKEtPress — Inficon VGC501 pressure gauge (hscal)
#
#   hispec deploy hscal_yjetpress
#
# copies this file to /etc/hispec/instances/hscal_hketpress.env and
# config/hscal/hscal_hketpress.yaml to /etc/hispec/hscal_hketpress.yaml, then
# enables and starts the daemon.
HISPEC_DAEMON=generic/inficon
HISPEC_HOST=hispecserver

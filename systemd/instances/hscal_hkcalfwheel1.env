# HISPEC CAL RED FilterWheel1 — Thorlabs FW102C controller instance (hscal)
#
# systemctl enable --now hispec-daemon@hscal_hkcalfwheel1
#
# Deploy the config alongside this file:
#   config/hscal/hscal_hkcalfwheel1.yaml -> /etc/hispec/hscal_hkcalfwheel1.yaml
HISPEC_DAEMON=generic/filterwheel
HISPEC_CONFIG=/etc/hispec/hscal_hkcalfwheel1.yaml

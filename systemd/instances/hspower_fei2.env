# HISPEC FEI PDU 2 of 4 (feidcpdu2) — DLI DC3 (48V/24V) networked PDU (hspower)
#
#   hispec deploy hspower_fei2
#
# copies this file to /etc/hispec/instances/hspower_fei2.env and
# config/hspower/hspower_fei2.yaml to /etc/hispec/hspower_fei2.yaml, then
# enables and starts the daemon.
#
# The Telnet login comes from HISPEC_PDU_USERNAME and HISPEC_FEIDLIPDU_PASSWORD
# in root-only /etc/hispec/secrets.env, not from here: this file is readable by
# every hispec-ops member.
HISPEC_DAEMON=hspower/dli_pdu
HISPEC_CONFIG=/etc/hispec/hspower_fei2.yaml
HISPEC_HOST=hispecserver

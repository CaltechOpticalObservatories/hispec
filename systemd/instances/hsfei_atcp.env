# ATC Pickoff Dichroic Selector, C-663 stepper instance (hsfei)
#
#   hispec deploy hsfei_atcp
#
# copies this file to /etc/hispec/instances/hsfei_atcp.env and
# config/hsfei/hsfei_atcp.yaml to /etc/hispec/hsfei_atcp.yaml, then enables
# and starts the daemon.
HISPEC_DAEMON=hsfei/pi-daemon
HISPEC_CONFIG=/etc/hispec/hsfei_atcp.yaml
HISPEC_HOST=hispecserver

# HISPEC BSPEC PDU (blueeaton1) — Eaton EMAT-08/10 networked PDU (hspower)
#
# hispec-enable --now hspower_bspec1
#
# Deploy the config alongside this file:
#   config/hspower/hspower_bspec1.yaml -> /etc/hispec/hspower_bspec1.yaml
#
# The Telnet login comes from HISPEC_PDU_USERNAME and HISPEC_PDU_PASSWORD in
# root-only /etc/hispec/secrets.env, not from here: this file is readable by
# every hispec-ops member.
HISPEC_DAEMON=hspower/pdu
HISPEC_CONFIG=/etc/hispec/hspower_bspec1.yaml

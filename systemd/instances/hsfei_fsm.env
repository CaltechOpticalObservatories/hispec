# Fast steering mirror, PI E-727 controller instance (hsfei)
#
#   hispec deploy hsfei_fsm
#
# copies this file to /etc/hispec/instances/hsfei_fsm.env and
# config/hsfei/hsfei_fsm.yaml to /etc/hispec/hsfei_fsm.yaml, then enables
# and starts the daemon. It runs on feiserver beside the tracking loop, which
# shares the mirror's access and halt shared memory with it.
HISPEC_DAEMON=hsfei/fsm
HISPEC_HOST=feiserver

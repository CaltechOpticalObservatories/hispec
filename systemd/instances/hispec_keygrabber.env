# Keyword Archiver — polls the HISPEC daemons into InfluxDB for Grafana
#
#   hispec deploy hispec_keygrabber
#
# copies this file to /etc/hispec/instances/hispec_keygrabber.env and
# config/hispec/hispec_keygrabber.yaml to /etc/hispec/hispec_keygrabber.yaml,
# then enables and starts the daemon.
#
# The InfluxDB token does NOT belong here: this directory is group-readable by
# every hispec-ops member. Put it in /etc/hispec/secrets.env instead, which is
# root-only and which the unit reads if present:
#   HISPEC_INFLUX_TOKEN=<token>
#
# Needs libby's optional extra in the venv:
#   /opt/hispec/venv/bin/pip install 'libby[influxdb]'
HISPEC_DAEMON=generic/keygrabber
HISPEC_CONFIG=/etc/hispec/hispec_keygrabber.yaml
HISPEC_HOST=hispecserver

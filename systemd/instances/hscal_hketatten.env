# HISPEC RED CAL Etalon Attenuator — Standa SMC8 controller instance (hscal)
#
#   hispec deploy hscal_hketatten
#
# copies this file to /etc/hispec/instances/hscal_hketatten.env and
# config/hscal/hscal_hketatten.yaml to /etc/hispec/hscal_hketatten.yaml, then
# enables and starts the daemon.
HISPEC_DAEMON=hscal/smc8_attenuator
HISPEC_CONFIG=/etc/hispec/hscal_hketatten.yaml
HISPEC_HOST=hispecserver

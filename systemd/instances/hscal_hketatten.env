# HISPEC RED CAL Etalon Attenuator — Standa SMC8 controller instance (hscal)
#
# systemctl enable --now hispec-daemon@hscal_hketatten
#
# Deploy the config alongside this file:
#   config/hscal/hscal_hketatten.yaml -> /etc/hispec/hscal_hketatten.yaml
HISPEC_DAEMON=hscal/smc8_attenuator
HISPEC_CONFIG=/etc/hispec/hscal_hketatten.yaml

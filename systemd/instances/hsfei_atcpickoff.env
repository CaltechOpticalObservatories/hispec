# ATC Pickoff Dichroic Selector — C-663 stepper instance (hsfei)
#
# systemctl enable --now hispec-daemon@hsfei_atcpickoff
#
# Deploy the config alongside this file:
#   config/hsfei/hsfei_atcpickoff.yaml -> /etc/hispec/hsfei_atcpickoff.yaml
HISPEC_DAEMON=hsfei/pi-daemon
HISPEC_CONFIG=/etc/hispec/hsfei_atcpickoff.yaml

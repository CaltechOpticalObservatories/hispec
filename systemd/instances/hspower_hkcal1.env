# HISPEC RED CAL PDU 1 of 3 — Eaton EMAT-08/10 networked PDU (hspower)
#
#   hispec deploy hspower_hkcal1
#
# copies this file to /etc/hispec/instances/hspower_hkcal1.env and
# config/hspower/hspower_hkcal1.yaml to /etc/hispec/hspower_hkcal1.yaml, then
# enables and starts the daemon.
#
# The Telnet login comes from HISPEC_PDU_USERNAME and HISPEC_REDEATON1_PASSWORD in
# root-only /etc/hispec/secrets.env, not from here: this file is readable by
# every hispec-ops member.
HISPEC_DAEMON=hspower/eaton_pdu
HISPEC_HOST=hispecserver

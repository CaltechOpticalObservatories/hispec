# HISPEC BLUE CAL Rack OneWire (yjcalrack) — OneWire metrology sensor (hsmet)
#
#   hispec deploy hsmet_yjcalrack
#
# copies this file to /etc/hispec/instances/hsmet_yjcalrack.env and
# config/hsmet/hsmet_yjcalrack.yaml to /etc/hispec/hsmet_yjcalrack.yaml, then
# enables and starts the daemon.
HISPEC_DAEMON=hsmet/onewire
HISPEC_HOST=hispecserver

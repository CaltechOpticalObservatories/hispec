# HISPEC FEI PDU 4 of 4 (feieaton2) — Eaton EMAT-08/10 networked PDU (hspower)
#
#   hispec deploy hspower_fei4
#
# copies this file to /etc/hispec/instances/hspower_fei4.env and
# config/hspower/hspower_fei4.yaml to /etc/hispec/hspower_fei4.yaml, then
# enables and starts the daemon.
#
# The Telnet login comes from HISPEC_PDU_USERNAME and HISPEC_FEIEATON2_PASSWORD
# in root-only /etc/hispec/secrets.env, not from here: this file is readable by
# every hispec-ops member.
HISPEC_DAEMON=hspower/eaton_pdu
HISPEC_CONFIG=/etc/hispec/hspower_fei4.yaml
HISPEC_HOST=hispecserver

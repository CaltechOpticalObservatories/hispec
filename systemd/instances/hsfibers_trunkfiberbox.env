# trunkfiberbox: FIB trunk interface box daemon (hsfibers)
#
#   hispec deploy hsfibers_trunkfiberbox
#
# copies this file to /etc/hispec/instances/hsfibers_trunkfiberbox.env and
# config/hsfibers/hsfibers_trunkfiberbox.yaml to
# /etc/hispec/hsfibers_trunkfiberbox.yaml, then enables and starts the daemon.
HISPEC_DAEMON=hsfibers/trunkfiberbox
HISPEC_HOST=hispecserver

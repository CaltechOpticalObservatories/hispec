# ATC Filter Wheel, Thorlabs FW102C controller instance (hsfei)
#
#   hispec deploy hsfei_atcfw
#
# copies this file to /etc/hispec/instances/hsfei_atcfw.env and
# config/hsfei/hsfei_atcfw.yaml to /etc/hispec/hsfei_atcfw.yaml, then enables
# and starts the daemon.
HISPEC_DAEMON=generic/filterwheel
HISPEC_CONFIG=/etc/hispec/hsfei_atcfw.yaml
HISPEC_HOST=hispecserver

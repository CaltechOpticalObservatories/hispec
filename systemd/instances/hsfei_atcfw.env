# ATC Filter Wheel, Thorlabs FW102C controller instance (hsfei)
#
# systemctl enable --now hispec-daemon@hsfei_atcfw
#
# Deploy the config alongside this file:
#   config/hsfei/hsfei_atcfw.yaml -> /etc/hispec/hsfei_atcfw.yaml
HISPEC_DAEMON=generic/filterwheel
HISPEC_CONFIG=/etc/hispec/hsfei_atcfw.yaml

# HISPEC SPEC Rack OneWire (specrack) — OneWire metrology sensor (hsmet)
#
#   hispec deploy hsmet_specrack
#
# copies this file to /etc/hispec/instances/hsmet_specrack.env and
# config/hsmet/hsmet_specrack.yaml to /etc/hispec/hsmet_specrack.yaml, then
# enables and starts the daemon.
HISPEC_DAEMON=hsmet/onewire
HISPEC_HOST=hispecserver

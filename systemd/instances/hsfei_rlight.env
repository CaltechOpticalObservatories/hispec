# FEI Retractable Light Source Module — H + V C-863 servo, daisy-chained (hsfei)
#
# systemctl enable --now hispec-daemon@hsfei_rlight
#
# Deploy the config alongside this file:
#   config/hsfei/hsfei_rlight.yaml -> /etc/hispec/hsfei_rlight.yaml
HISPEC_DAEMON=hsfei/pi-daemon
HISPEC_CONFIG=/etc/hispec/hsfei_rlight.yaml

# PIAA Gimbal Mount R, PPC102 piezo controller (hsfei)
#
#   hispec deploy hsfei_piaagimr
#
# copies this file to /etc/hispec/instances/hsfei_piaagimr.env and
# config/hsfei/hsfei_piaagimr.yaml to /etc/hispec/hsfei_piaagimr.yaml, then
# enables and starts the daemon.
HISPEC_DAEMON=hsfei/piaa-gimbalmount
HISPEC_CONFIG=/etc/hispec/hsfei_piaagimr.yaml
HISPEC_HOST=hispecserver

# PIAA Gimbal Mount R, PPC102 piezo controller (hsfei)
#
# systemctl enable --now hispec-daemon@hsfei_piaagimr
#
# Deploy the config alongside this file:
#   config/hsfei/hsfei_piaagimr.yaml -> /etc/hispec/hsfei_piaagimr.yaml
HISPEC_DAEMON=hsfei/piaa-gimbalmount
HISPEC_CONFIG=/etc/hispec/hsfei_piaagimr.yaml

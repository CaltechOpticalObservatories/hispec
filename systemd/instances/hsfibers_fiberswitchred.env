# fiberswitchred: Red (HK) fiber switcher daemon (hsfibers)
#
#   hispec deploy hsfibers_fiberswitchred
#
# copies this file to /etc/hispec/instances/hsfibers_fiberswitchred.env and
# config/hsfibers/hsfibers_fiberswitchred.yaml to
# /etc/hispec/hsfibers_fiberswitchred.yaml, then enables and starts the daemon.
# The host must reach the red PLC. Inspections go through the
# hsfibers_fiberswitchredcam daemon.
HISPEC_DAEMON=hsfibers/fiberswitch
HISPEC_HOST=hispecserver

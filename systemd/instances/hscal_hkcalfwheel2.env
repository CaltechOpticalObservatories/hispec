# HISPEC CAL RED FilterWheel2 — Thorlabs FW102C controller instance (hscal)
#
# systemctl enable --now hispec-daemon@hscal_hkcalfwheel2
#
# Deploy the config alongside this file:
#   config/hscal/hscal_hkcalfwheel2.yaml -> /etc/hispec/hscal_hkcalfwheel2.yaml
HISPEC_DAEMON=generic/filterwheel
HISPEC_CONFIG=/etc/hispec/hscal_hkcalfwheel2.yaml

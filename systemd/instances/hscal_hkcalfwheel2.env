# HISPEC CAL RED FilterWheel2 — Thorlabs FW102C controller instance (hscal)
#
#   hispec deploy hscal_hkcalfwheel2
#
# copies this file to /etc/hispec/instances/hscal_hkcalfwheel2.env and
# config/hscal/hscal_hkcalfwheel2.yaml to
# /etc/hispec/hscal_hkcalfwheel2.yaml, then enables and starts the daemon.
HISPEC_DAEMON=generic/filterwheel
HISPEC_CONFIG=/etc/hispec/hscal_hkcalfwheel2.yaml
HISPEC_HOST=hispecserver

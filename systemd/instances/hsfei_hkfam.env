# RED Fiber Alignment Mechanism (FAMr) — Xeryon XD-M-3, three axes (hsfei)
#
#   hispec deploy hsfei_hkfam
#
# copies this file to /etc/hispec/instances/hsfei_hkfam.env and
# config/hsfei/hsfei_hkfam.yaml to /etc/hispec/hsfei_hkfam.yaml, then enables
# and starts the daemon.
HISPEC_DAEMON=hsfei/xeryon
HISPEC_CONFIG=/etc/hispec/hsfei_hkfam.yaml
HISPEC_HOST=hispecserver

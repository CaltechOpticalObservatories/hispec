# RED Fiber Alignment Mechanism (FAMr) — Xeryon XD-M-3, three axes (hsfei)
#
# systemctl enable --now hispec-daemon@hsfei_hkfam
#
# Deploy the config alongside this file:
#   config/hsfei/hsfei_hkfam.yaml -> /etc/hispec/hsfei_hkfam.yaml
HISPEC_DAEMON=hsfei/xeryon
HISPEC_CONFIG=/etc/hispec/hsfei_hkfam.yaml

# HISPEC FEI PDU 1 of 2 (feieaton1) — Eaton EMAT-08/10 networked PDU (hspower)
#
#   hispec deploy hspower_fei1
#
# copies this file to /etc/hispec/instances/hspower_fei1.env and
# config/hspower/hspower_fei1.yaml to /etc/hispec/hspower_fei1.yaml, then
# enables and starts the daemon.
#
# The Telnet login comes from HISPEC_PDU_USERNAME and HISPEC_PDU_PASSWORD in
# root-only /etc/hispec/secrets.env, not from here: this file is readable by
# every hispec-ops member.
HISPEC_DAEMON=hspower/eaton_pdu
HISPEC_CONFIG=/etc/hispec/hspower_fei1.yaml
HISPEC_HOST=hispecserver

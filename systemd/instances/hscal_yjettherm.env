# CAL BLUE (YJ) Etalon SRS PTC10 thermal controller (hscal)
#
#   hispec deploy hscal_yjettherm
#
# copies this file to /etc/hispec/instances/hscal_yjettherm.env and
# config/hscal/hscal_yjettherm.yaml to /etc/hispec/hscal_yjettherm.yaml, then
# enables and starts the daemon.
HISPEC_DAEMON=hscal/srs_thermal
HISPEC_HOST=hispecserver

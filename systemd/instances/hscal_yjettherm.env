# CAL BLUE (YJ) Etalon SRS PTC10 thermal controller (hscal)
#
# systemctl enable --now hispec-daemon@hscal_yjettherm
#
# Deploy the config alongside this file:
#   config/hscal/hscal_yjettherm.yaml -> /etc/hispec/hscal_yjettherm.yaml
HISPEC_DAEMON=generic/srsthermal
HISPEC_CONFIG=/etc/hispec/hscal_yjettherm.yaml

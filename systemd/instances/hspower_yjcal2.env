# HISPEC BLUE CAL PDU 2 of 2 — Eaton EMAT-08/10 networked PDU (hspower)
#
#   hispec deploy hspower_yjcal2
#
# copies this file to /etc/hispec/instances/hspower_yjcal2.env and
# config/hspower/hspower_yjcal2.yaml to /etc/hispec/hspower_yjcal2.yaml, then
# enables and starts the daemon.
#
# The Telnet login comes from HISPEC_PDU_USERNAME and HISPEC_BLUEEATON2_PASSWORD in
# root-only /etc/hispec/secrets.env, not from here: this file is readable by
# every hispec-ops member.
HISPEC_DAEMON=hspower/eaton_pdu
HISPEC_HOST=hispecserver

# FEI Pickoff Mirror, C-663 stepper instance (hsfei)
#
#   hispec deploy hsfei_feipo
#
# copies this file to /etc/hispec/instances/hsfei_feipo.env and
# config/hsfei/hsfei_feipo.yaml to /etc/hispec/hsfei_feipo.yaml, then enables
# and starts the daemon.
HISPEC_DAEMON=hsfei/pi-daemon
HISPEC_CONFIG=/etc/hispec/hsfei_feipo.yaml
HISPEC_HOST=hispecserver

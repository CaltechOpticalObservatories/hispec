# ADC Rotator — two Newport SMC100PP prism rotators, daisy-chained (hsfei)
#
#   hispec deploy hsfei_adc
#
# copies this file to /etc/hispec/instances/hsfei_adc.env and
# config/hsfei/hsfei_adc.yaml to /etc/hispec/hsfei_adc.yaml, then enables and
# starts the daemon.
HISPEC_DAEMON=hsfei/adc
HISPEC_CONFIG=/etc/hispec/hsfei_adc.yaml
HISPEC_HOST=hispecserver

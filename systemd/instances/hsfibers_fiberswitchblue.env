# fiberswitchblue: Blue (YJ) fiber switcher daemon (hsfibers)
#
#   hispec deploy hsfibers_fiberswitchblue
#
# copies this file to /etc/hispec/instances/hsfibers_fiberswitchblue.env and
# config/hsfibers/hsfibers_fiberswitchblue.yaml to
# /etc/hispec/hsfibers_fiberswitchblue.yaml, then enables and starts the daemon.
# The host must reach the blue PLC. Inspections go through the
# hsfibers_fiberswitchbluecam daemon.
HISPEC_DAEMON=hsfibers/fiberswitch
HISPEC_HOST=hispecserver

# fiberswitchredcam: Red (HK) fiber switcher inspection camera daemon (hsfibers)
#
#   hispec deploy hsfibers_fiberswitchredcam
#
# copies this file to /etc/hispec/instances/hsfibers_fiberswitchredcam.env and
# config/hsfibers/hsfibers_fiberswitchredcam.yaml to
# /etc/hispec/hsfibers_fiberswitchredcam.yaml, then enables and starts the daemon.
# The host must either have the red DI-2000 plugged in over USB or reach the
# camserver named by camera.remote in the config.
HISPEC_DAEMON=hsfibers/fiberswitchcam
HISPEC_HOST=hispecserver

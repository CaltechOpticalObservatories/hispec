# ATCLakeshore — Lakeshore 336 (opt 3062) for the ATC dewar (hsfei)
#
# systemctl enable --now hispec-daemon@hsfei_atctherm
#
# Deploy the config alongside this file:
#   config/hsfei/hsfei_atctherm.yaml -> /etc/hispec/hsfei_atctherm.yaml
HISPEC_DAEMON=generic/lakeshore
HISPEC_CONFIG=/etc/hispec/hsfei_atctherm.yaml

# ATCLakeshore — Lakeshore 336 (opt 3062) for the ATC dewar (hsfei)
#
#   hispec deploy hsfei_atctherm
#
# copies this file to /etc/hispec/instances/hsfei_atctherm.env and
# config/hsfei/hsfei_atctherm.yaml to /etc/hispec/hsfei_atctherm.yaml, then
# enables and starts the daemon.
HISPEC_DAEMON=generic/lakeshore
HISPEC_CONFIG=/etc/hispec/hsfei_atctherm.yaml
HISPEC_HOST=hispecserver

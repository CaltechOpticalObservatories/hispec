# Acquisition and tracking camera, H2RG on an Archon (hsfei)
#
#   hispec deploy hsfei_atcam
#
# copies this file to /etc/hispec/instances/hsfei_atcam.env and
# config/hsfei/hsfei_atcam.yaml to /etc/hispec/hsfei_atcam.yaml, then enables
# and starts the daemon. Only feiserver runs it: the Archon and the camera
# module are there.
HISPEC_DAEMON=generic/camera
HISPEC_HOST=feiserver

# ATCCryo — Sunpower Cryocooler daemon (hsfei)
#
#   hispec deploy hsfei_atccryo
#
# copies this file to /etc/hispec/instances/hsfei_atccryo.env and
# config/hsfei/hsfei_atccryo.yaml to /etc/hispec/hsfei_atccryo.yaml, then
# enables and starts the daemon.
HISPEC_DAEMON=hsfei/atccryo
HISPEC_CONFIG=/etc/hispec/hsfei_atccryo.yaml
HISPEC_HOST=hispecserver

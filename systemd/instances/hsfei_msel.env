# FEI Mask Selector — H C-863 servo + V C-663 stepper, daisy-chained (hsfei)
#
# systemctl enable --now hispec-daemon@hsfei_msel
#
# Deploy the config alongside this file:
#   config/hsfei/hsfei_msel.yaml -> /etc/hispec/hsfei_msel.yaml
HISPEC_DAEMON=hsfei/pi-daemon
HISPEC_CONFIG=/etc/hispec/hsfei_msel.yaml

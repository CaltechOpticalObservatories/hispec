# FEI Retractable Light Source Module, H + V C-863 servo, daisy-chained (hsfei)
#
#   hispec deploy hsfei_lsm
#
# copies this file to /etc/hispec/instances/hsfei_lsm.env and
# config/hsfei/hsfei_lsm.yaml to /etc/hispec/hsfei_lsm.yaml, then enables and
# starts the daemon.
HISPEC_DAEMON=hsfei/pi-daemon
HISPEC_CONFIG=/etc/hispec/hsfei_lsm.yaml
HISPEC_HOST=hispecserver

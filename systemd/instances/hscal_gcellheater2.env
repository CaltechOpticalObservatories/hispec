# CAL RED Gas Cell Lakeshore 2 — Model 336: NH3 and CO2 gas cells (hscal)
#
#   hispec deploy hscal_gcellheater2
#
# copies this file to /etc/hispec/instances/hscal_gcellheater2.env and
# config/hscal/hscal_gcellheater2.yaml to
# /etc/hispec/hscal_gcellheater2.yaml, then enables and starts the daemon.
HISPEC_DAEMON=generic/lakeshore
HISPEC_CONFIG=/etc/hispec/hscal_gcellheater2.yaml
HISPEC_HOST=hispecserver

# CAL RED Gas Cell Lakeshore 2 — Model 336: NH3 and CO2 gas cells (hscal)
#
# systemctl enable --now hispec-daemon@hscal_gcellheater2
#
# Deploy the config alongside this file:
#   config/hscal/hscal_gcellheater2.yaml -> /etc/hispec/hscal_gcellheater2.yaml
HISPEC_DAEMON=generic/lakeshore
HISPEC_CONFIG=/etc/hispec/hscal_gcellheater2.yaml

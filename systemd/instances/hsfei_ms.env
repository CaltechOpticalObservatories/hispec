# FEI Mask Selector, H C-863 servo + V C-663 stepper, daisy-chained (hsfei)
#
#   hispec deploy hsfei_ms
#
# copies this file to /etc/hispec/instances/hsfei_ms.env and
# config/hsfei/hsfei_ms.yaml to /etc/hispec/hsfei_ms.yaml, then enables and
# starts the daemon.
HISPEC_DAEMON=hsfei/pi-daemon
HISPEC_CONFIG=/etc/hispec/hsfei_ms.yaml
HISPEC_HOST=hispecserver

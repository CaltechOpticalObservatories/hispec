# Focal/Pupil Plane Selector — C-663 stepper instance (hsfei)
#
# systemctl enable --now hispec-daemon@hsfei_focpupsel
#
# Deploy the config alongside this file:
#   config/hsfei/hsfei_focpupsel.yaml -> /etc/hispec/hsfei_focpupsel.yaml
HISPEC_DAEMON=hsfei/pi-daemon
HISPEC_CONFIG=/etc/hispec/hsfei_focpupsel.yaml

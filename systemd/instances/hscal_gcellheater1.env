# CAL RED Gas Cell Lakeshore 1 — Model 336: N2O and CH4/H2O gas cells (hscal)
#
# systemctl enable --now hispec-daemon@hscal_gcellheater1
#
# Deploy the config alongside this file:
#   config/hscal/hscal_gcellheater1.yaml -> /etc/hispec/hscal_gcellheater1.yaml
HISPEC_DAEMON=generic/lakeshore
HISPEC_CONFIG=/etc/hispec/hscal_gcellheater1.yaml

# CAL RED Gas Cell Lakeshore 1 — Model 336: N2O and CH4/H2O gas cells (hscal)
#
#   hispec deploy hscal_gcellheater1
#
# copies this file to /etc/hispec/instances/hscal_gcellheater1.env and
# config/hscal/hscal_gcellheater1.yaml to
# /etc/hispec/hscal_gcellheater1.yaml, then enables and starts the daemon.
HISPEC_DAEMON=generic/lakeshore
HISPEC_CONFIG=/etc/hispec/hscal_gcellheater1.yaml
HISPEC_HOST=hispecserver

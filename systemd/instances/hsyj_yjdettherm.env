# YJDETTHERM - Lakeshore 336 for the BSPEC detector (hsyj)
#
#   hispec deploy hsyj_yjdettherm
#
# copies this file to /etc/hispec/instances/hsyj_yjdettherm.env and
# config/hsyj/hsyj_yjdettherm.yaml to /etc/hispec/hsyj_yjdettherm.yaml, then
# enables and starts the daemon.
HISPEC_DAEMON=generic/lakeshore
HISPEC_CONFIG=/etc/hispec/hsyj_yjdettherm.yaml
HISPEC_HOST=hispecserver

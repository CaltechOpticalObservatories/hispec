# HISPEC RED CAL Rack OneWire (hkcalrack) — OneWire metrology sensor (hsmet)
#
#   hispec deploy hsmet_hkcalrack
#
# copies this file to /etc/hispec/instances/hsmet_hkcalrack.env and
# config/hsmet/hsmet_hkcalrack.yaml to /etc/hispec/hsmet_hkcalrack.yaml, then
# enables and starts the daemon.
HISPEC_DAEMON=hsmet/onewire
HISPEC_HOST=hispecserver

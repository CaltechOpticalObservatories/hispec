# fiberswitchbluecam: Blue (YJ) fiber switcher inspection camera daemon (hsfibers)
#
#   hispec deploy hsfibers_fiberswitchbluecam
#
# copies this file to /etc/hispec/instances/hsfibers_fiberswitchbluecam.env and
# config/hsfibers/hsfibers_fiberswitchbluecam.yaml to
# /etc/hispec/hsfibers_fiberswitchbluecam.yaml, then enables and starts the daemon.
# The host must either have the blue DI-2000 plugged in over USB or reach the
# camserver named by camera.remote in the config.
HISPEC_DAEMON=hsfibers/fiberswitchcam
HISPEC_HOST=hispecserver

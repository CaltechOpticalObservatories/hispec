# YJEtVacIon — Gamma Vacuum SPCe Vac-Ion pressure gauge (hscal)
#
#   hispec deploy hscal_yjetvacion
#
# copies this file to /etc/hispec/instances/hscal_yjetvacion.env and
# config/hscal/hscal_yjetvacion.yaml to /etc/hispec/hscal_yjetvacion.yaml, then
# enables and starts the daemon.
HISPEC_DAEMON=hscal/gammavac
HISPEC_HOST=hispecserver

# ATCPress — Inficon VGC502 pressure gauge (hsfei)
#
#   hispec deploy hsfei_atcpress
#
# copies this file to /etc/hispec/instances/hsfei_atcpress.env and
# config/hsfei/hsfei_atcpress.yaml to /etc/hispec/hsfei_atcpress.yaml, then
# enables and starts the daemon.
HISPEC_DAEMON=generic/inficon
HISPEC_CONFIG=/etc/hispec/hsfei_atcpress.yaml
HISPEC_HOST=hispecserver

# HISPEC CAL PDU 2 of 4 — Eaton EMAT-08/10 networked PDU (hspower)
#
#   hispec deploy hspower_cal2
#
# copies this file to /etc/hispec/instances/hspower_cal2.env and
# config/hspower/hspower_cal2.yaml to /etc/hispec/hspower_cal2.yaml, then
# enables and starts the daemon.
#
# The Telnet login comes from HISPEC_PDU_USERNAME and HISPEC_PDU_PASSWORD in
# root-only /etc/hispec/secrets.env, not from here: this file is readable by
# every hispec-ops member.
HISPEC_DAEMON=hspower/eaton_pdu
HISPEC_CONFIG=/etc/hispec/hspower_cal2.yaml
HISPEC_HOST=hispecserver

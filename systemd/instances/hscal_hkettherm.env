# CAL RED (HK) Etalon SRS PTC10 thermal controller (hscal)
#
#   hispec deploy hscal_hkettherm
#
# copies this file to /etc/hispec/instances/hscal_hkettherm.env and
# config/hscal/hscal_hkettherm.yaml to /etc/hispec/hscal_hkettherm.yaml, then
# enables and starts the daemon.
HISPEC_DAEMON=generic/srsthermal
HISPEC_CONFIG=/etc/hispec/hscal_hkettherm.yaml
HISPEC_HOST=hispecserver

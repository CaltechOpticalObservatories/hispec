# YJPress — Inficon VGC502 pressure gauge (hsyj)
#
#   hispec deploy hsyj_yjpress
#
# copies this file to /etc/hispec/instances/hsyj_yjpress.env and
# config/hsyj/hsyj_yjpress.yaml to /etc/hispec/hsyj_yjpress.yaml, then
# enables and starts the daemon.
HISPEC_DAEMON=generic/inficon
HISPEC_CONFIG=/etc/hispec/hsyj_yjpress.yaml
HISPEC_HOST=hispecserver

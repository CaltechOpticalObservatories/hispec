# PIAA lens deploy, RED and BLUE — Xeryon XD-M-3, two wired axes (hsfei)
#
# systemctl start hispec@hsfei_piaadeploy
#
# Deploy the config alongside this file:
#   config/hsfei/hsfei_piaadeploy.yaml -> /etc/hispec/hsfei_piaadeploy.yaml
HISPEC_DAEMON=hsfei/xeryon
HISPEC_CONFIG=/etc/hispec/hsfei_piaadeploy.yaml

# PIAA lens deploy, RED and BLUE — Xeryon XD-M-3, two wired axes (hsfei)
#
#   hispec deploy hsfei_piaadeploy
#
# copies this file to /etc/hispec/instances/hsfei_piaadeploy.env and
# config/hsfei/hsfei_piaadeploy.yaml to /etc/hispec/hsfei_piaadeploy.yaml,
# then enables and starts the daemon.
HISPEC_DAEMON=hsfei/xeryon
HISPEC_CONFIG=/etc/hispec/hsfei_piaadeploy.yaml
HISPEC_HOST=hispecserver

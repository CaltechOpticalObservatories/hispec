# HISPEC CAL BLUE FilterWheel1 — Thorlabs FW102C controller instance (hscal)
#
#   hispec deploy hscal_yjcalfwheel1
#
# copies this file to /etc/hispec/instances/hscal_yjcalfwheel1.env and
# config/hscal/hscal_yjcalfwheel1.yaml to
# /etc/hispec/hscal_yjcalfwheel1.yaml, then enables and starts the daemon.
HISPEC_DAEMON=generic/filterwheel
HISPEC_CONFIG=/etc/hispec/hscal_yjcalfwheel1.yaml
HISPEC_HOST=hispecserver

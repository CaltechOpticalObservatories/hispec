# HISPEC CAL BLUE FilterWheel1 — Thorlabs FW102C controller instance (hscal)
#
# systemctl enable --now hispec-daemon@hscal_yjcalfwheel1
#
# Deploy the config alongside this file:
#   config/hscal/hscal_yjcalfwheel1.yaml -> /etc/hispec/hscal_yjcalfwheel1.yaml
HISPEC_DAEMON=generic/filterwheel
HISPEC_CONFIG=/etc/hispec/hscal_yjcalfwheel1.yaml

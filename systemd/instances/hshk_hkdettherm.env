# HKDETTHERM - Lakeshore 336 for the RSPEC detector (hshk)
#
#   hispec deploy hshk_hkdettherm
#
# copies this file to /etc/hispec/instances/hshk_hkdettherm.env and
# config/hshk/hshk_hkdettherm.yaml to /etc/hispec/hshk_hkdettherm.yaml, then
# enables and starts the daemon.
HISPEC_DAEMON=generic/lakeshore
HISPEC_CONFIG=/etc/hispec/hshk_hkdettherm.yaml
HISPEC_HOST=hispecserver

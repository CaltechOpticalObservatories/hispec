# BLUE Fiber Alignment Mechanism (FAMb) — Xeryon XD-M-3, three axes (hsfei)
#
#   hispec deploy hsfei_yjfam
#
# copies this file to /etc/hispec/instances/hsfei_yjfam.env and
# config/hsfei/hsfei_yjfam.yaml to /etc/hispec/hsfei_yjfam.yaml, then enables
# and starts the daemon.
HISPEC_DAEMON=hsfei/xeryon
HISPEC_CONFIG=/etc/hispec/hsfei_yjfam.yaml
HISPEC_HOST=hispecserver

# BLUE Fiber Alignment Mechanism (FAMb) — Xeryon XD-M-3, three axes (hsfei)
#
# systemctl enable --now hispec-daemon@hsfei_yjfam
#
# Deploy the config alongside this file:
#   config/hsfei/hsfei_yjfam.yaml -> /etc/hispec/hsfei_yjfam.yaml
HISPEC_DAEMON=hsfei/xeryon
HISPEC_CONFIG=/etc/hispec/hsfei_yjfam.yaml

# HISPEC hardware daemon: systemd template unit.
#
# This is a template: one file manages any daemons/<subdir>/<script>
# that is a HispecDaemon subclass taking `-c <config.yaml>` and blocking in
# daemon.serve()
#
# Instantiated per running daemon via the "%i" instance name, e.g.:
#
#   systemctl start hispec@hsfei_atcpress
#   systemctl start hispec@hscal_gcellheater1
#   systemctl start hispec@hscal_gcellheater2
#
# Each instance name maps to an EnvironmentFile at
# /etc/hispec/instances/<instance>.env which says which daemon script to run
# (HISPEC_DAEMON, as a path relative to daemons/, e.g. "generic/inficon" or
# "hsfei/adc") and which config file to pass it (see systemd/instances/*.env
# and docs/operations/systemd.md for setup instructions).

[Unit]
Description=HISPEC hardware daemon (%i)
Documentation=https://caltechopticalobservatories.github.io/hispec/operations/systemd.html
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=hispec
Group=hispec

EnvironmentFile=/etc/hispec/instances/%i.env
# Optional, root-only, shared by every instance: for secrets that must not sit
# in the instance files above, since /etc/hispec/instances is group-readable by
# hispec-ops. systemd reads this as root before dropping to User= below.
EnvironmentFile=-/etc/hispec/secrets.env
# Drivers write their own .log next to the working directory, so this has to
# be writable by User= above; the repo checkout is not
WorkingDirectory=/var/log/hispec
ExecStart=/opt/hispec/venv/bin/python3 /opt/hispec/app/daemons/${HISPEC_DAEMON} -c ${HISPEC_CONFIG}

Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillSignal=SIGTERM

# The daemon logs to stderr/stdout unless its YAML config sets logging.file,
# so by default everything lands in the journal:
#   journalctl -u hispec@%i -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hispec-%i

# Basic sandboxing. Loosen ProtectSystem/ProtectHome if a driver needs write
# access outside /etc/hispec, /var/log/hispec (e.g. a serial device node
# under /dev is unaffected by these two).
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

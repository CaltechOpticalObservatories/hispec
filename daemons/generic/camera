#!/usr/bin/env python3
"""
Camera daemon for camerad instruments.

The generic camera keywords come from camera_daemon.CameraService. Anything
instrument-specific comes from an instrument object named in config, which
registers its own keywords, so one script runs every camera.
"""

import argparse
import importlib
import sys

from camera_daemon import CameraService

from hispec.daemon import HispecDaemon  # pylint: disable=E0611


class CameraDaemon(HispecDaemon):  # pylint: disable=W0223
    """Daemon for one camerad camera, generic across instruments."""

    def __init__(self):
        super().__init__()

        self.camera = None
        self.instrument = None
        self.service = CameraService(self)

    def on_start(self, _libby):
        """Register keywords, then try to reach the camera."""
        self.instrument = self._load_instrument()

        self.service.register_keywords(self.keyword_registry)
        if self.instrument is not None:
            self.instrument.register_keywords(self.keyword_registry)

        self.logger.info("Starting %s", self.peer_id)
        self.service.connect()

    def on_stop(self, _libby=None):
        """Release the camera."""
        self.logger.info("Shutting down %s", self.peer_id)
        self.service.on_stop()

    def _load_instrument(self):
        """Import the instrument object named in config, if there is one."""
        path = self.get_config("camera.instrument")
        if not path:
            self.logger.info("No instrument object configured; generic keywords only")
            return None
        module_name, _, attribute = path.rpartition(".")
        try:
            module = importlib.import_module(module_name)
            return getattr(module, attribute)(self)
        except (ImportError, AttributeError, TypeError) as exc:
            self.logger.error("Instrument object %s unusable: %s", path, exc)
            return None


def main():
    """Main entry point for the daemon."""
    parser = argparse.ArgumentParser(description="Camera daemon for camerad instruments")
    parser.add_argument("-c", "--config", type=str,
                        help="Path to config file (YAML or JSON)")

    args = parser.parse_args()

    if not args.config:
        print("--config is required", file=sys.stderr)
        sys.exit(2)

    try:
        daemon = CameraDaemon.from_config_file(args.config)
        daemon.serve()
    except KeyboardInterrupt:
        print("\nDaemon interrupted by user")
        sys.exit(0)
    except Exception as exc:  # pylint: disable=W0718
        print(f"Error running daemon: {exc}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()

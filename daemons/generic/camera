#!/usr/bin/env python3
"""
Camera daemon for camerad instruments.

Serves the keywords every camerad camera has. Anything instrument-specific
comes from an instrument object named in config, which registers its own
keywords, so one script runs every camera.
"""

import argparse
import importlib
import sys
import threading
from typing import Any, List, Optional

from hispec.daemon import HispecDaemon  # pylint: disable=E0611
from hispec.driver.pycamerad import Camerad, ModuleNotAvailable  # pylint: disable=E0611

# An exposure blocks the RPC, so the keyword needs a timeout longer than one
EXPOSE_TIMEOUT_S = 3600.0

STATE_NOCAMERA = "nocamera"
STATE_IDLE = "idle"
STATE_EXPOSING = "exposing"
STATE_ERROR = "error"


class CameraDaemon(HispecDaemon):  # pylint: disable=W0223
    """Daemon for one camerad camera, generic across instruments."""

    def __init__(self):
        super().__init__()

        self.camera: Optional[Camerad] = None
        self.instrument = None
        self.config_file = None
        self.nframes = 1
        self._state = STATE_NOCAMERA
        self._isopen = False
        self._command_lock = threading.Lock()

    ### lifecycle

    def on_start(self, _libby):
        """Register keywords, then try to reach the camera."""
        self.config_file = self.get_config("camera.config_file")
        self.nframes = int(self.get_config("camera.nframes", 1))

        self.instrument = self._load_instrument()
        self._register_keywords()
        if self.instrument is not None:
            self.instrument.register_keywords(self.keyword_registry)

        self.logger.info("Starting %s", self.peer_id)

        if not self.config_file:
            self.logger.error("camera.config_file is not set")
            return

        try:
            self._build_camera()
            self.logger.info("Camera built from %s", self.config_file)
        except (ModuleNotAvailable, RuntimeError, OSError) as exc:
            self.logger.error("Camera unavailable: %s", exc)

    def on_stop(self, _libby=None):
        """Abort anything running, then drop the connection."""
        self.logger.info("Shutting down %s", self.peer_id)
        if self.camera is None:
            return
        try:
            if self._state == STATE_EXPOSING:
                self.camera.abort()
            self.camera.close()
        except (RuntimeError, OSError) as exc:
            self.logger.error("Error releasing the camera: %s", exc)

    def _load_instrument(self):
        """Import the instrument object named in config, if there is one."""
        path = self.get_config("camera.instrument")
        if not path:
            self.logger.info("No instrument object configured; generic keywords only")
            return None
        module_name, _, attribute = path.rpartition(".")
        try:
            module = importlib.import_module(module_name)
            return getattr(module, attribute)(self)
        except (ImportError, AttributeError, TypeError) as exc:
            self.logger.error("Instrument object %s unusable: %s", path, exc)
            return None

    def _build_camera(self) -> None:
        camera_class = getattr(self.instrument, "camera_class", Camerad)
        self.camera = camera_class.from_config(self.config_file)
        self._state = STATE_IDLE

    ### generic keywords

    def _register_keywords(self) -> None:
        self.keyword_registry.string("state",
                                     getter=lambda: self._state,
                                     description="nocamera, idle, exposing or error.")
        self.keyword_registry.bool("isconnected",
                                   getter=lambda: self.camera is not None,
                                   description="Camera object exists for this config.")
        self.keyword_registry.bool("isopen",
                                   getter=lambda: self._isopen,
                                   description="Controller connection has been opened.")
        self.keyword_registry.bool("ispowered",
                                   getter=self._is_powered,
                                   setter=self._set_powered,
                                   description="Detector power is on.")
        self.keyword_registry.trigger("initialize",
                                      action=self._initialize,
                                      timeout_s=EXPOSE_TIMEOUT_S,
                                      description="Open, load firmware and power on.")
        self.keyword_registry.float("exptime",
                                    getter=self._get_exptime,
                                    setter=self._set_exptime,
                                    units="s",
                                    description="Exposure time.")
        self.keyword_registry.int("nframes",
                                  getter=lambda: self.nframes,
                                  setter=self._set_nframes,
                                  validator=self._check_nframes,
                                  description="Frame count used by expose.")
        self.keyword_registry.trigger("expose",
                                      action=self._expose,
                                      timeout_s=EXPOSE_TIMEOUT_S,
                                      description="Take nframes exposures.")
        self.keyword_registry.trigger("abort",
                                      action=self._abort,
                                      description="Abort the running exposure.")
        self.keyword_registry.string("lastframe",
                                     getter=self._last_frame,
                                     description="Path of the last file written.")

    def _require_camera(self) -> Camerad:
        if self.camera is None:
            raise RuntimeError("no camera; check camera.config_file and the installed module")
        return self.camera

    def _is_powered(self) -> bool:
        return bool(self._require_camera().power())

    def _set_powered(self, value: bool) -> None:
        self._require_camera().power(bool(value))

    def _initialize(self) -> None:
        """Run the camera's startup sequence, then the instrument's own."""
        camera = self._require_camera()
        with self._command_lock:
            camera.initialize()
            self._isopen = True
            self._state = STATE_IDLE

    def _get_exptime(self) -> float:
        return float(self._require_camera().exptime())

    def _set_exptime(self, value: float) -> None:
        self._require_camera().exptime(float(value))

    def _check_nframes(self, value: Any) -> Optional[str]:
        try:
            if int(value) < 1:
                return "nframes must be at least 1"
        except (TypeError, ValueError):
            return "nframes must be an integer"
        return None

    def _set_nframes(self, value: int) -> None:
        self.nframes = int(value)

    def _expose(self) -> None:
        camera = self._require_camera()
        with self._command_lock:
            self._state = STATE_EXPOSING
            try:
                camera.expose(self.nframes)
            except RuntimeError:
                self._state = STATE_ERROR
                raise
            finally:
                if self._state == STATE_EXPOSING:
                    self._state = STATE_IDLE

    def _abort(self) -> None:
        self._require_camera().abort()

    def _last_frame(self) -> str:
        written: List[str] = [output.last_written
                              for output in self._require_camera().output_status()
                              if output.last_written]
        return written[-1] if written else ""


def main():
    """Main entry point for the daemon."""
    parser = argparse.ArgumentParser(description="Camera daemon for camerad instruments")
    parser.add_argument("-c", "--config", type=str,
                        help="Path to config file (YAML or JSON)")

    args = parser.parse_args()

    if not args.config:
        print("--config is required", file=sys.stderr)
        sys.exit(2)

    try:
        daemon = CameraDaemon.from_config_file(args.config)
        daemon.serve()
    except KeyboardInterrupt:
        print("\nDaemon interrupted by user")
        sys.exit(0)
    except Exception as exc:  # pylint: disable=W0718
        print(f"Error running daemon: {exc}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()

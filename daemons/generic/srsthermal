#!/usr/bin/env python3
"""
Generic Stanford Research Systems PTC10 Thermal control Daemon

Exposes the SRS PTC10 Temperature controller commands as libby keywords.
"""

import argparse
import sys
import time

from hispec import HispecDaemon
from hispec.driver.srs.ptc10 import PTC10


class SRSThermalDaemon(HispecDaemon):  # pylint: disable=W0223,too-many-instance-attributes
    """Daemon for controlling the SRS PTC10 via keywords."""

    def __init__(self):
        super().__init__()

        self.ip_address = None
        self.tcp_port = None
        self.units = None
        self.sensors = None
        self.heaters = None
        self.error = None
        self.start_time = None

        # The controller needs hardware settings that from_config only populates
        # after __init__ returns, so it is built in on_start instead.
        self.controller = None

    def on_start(self, libby):
        """Called when the daemon starts - register keywords and connect."""
        self.start_time = time.monotonic()

        # from_config populates _config after __init__, so read it here
        self.ip_address = self.get_config("hardware.ip_address")
        self.tcp_port = self.get_config("hardware.tcp_port")
        self.sensors = self.get_config("sensors") or []
        self.heaters = self.get_config("heaters") or []

        self.controller = PTC10(log=True)

        self.logger.info("Starting %s daemon", self.peer_id)
        self.logger.info("Using sensors: %s", self.sensors)
        self.logger.info("Using heaters: %s", self.heaters)

        self._register_sensor_keywords()
        self._register_heater_keywords()

        self.keyword_registry.bool("isconnected",
                                   getter=self.controller.is_connected,
                                   setter=self._set_connected,
                                   description="SRS PTC10 controller is connected.")
        self.keyword_registry.string("error",
                                     getter=self._error_string,
                                     description="Last error from the SRS PTC10 controller.")

        if not (self.ip_address and self.tcp_port):
            self.logger.error("No IP address or port specified")
            return

        try:
            self._connect_hardware()
            self.logger.info("Daemon started successfully and connected to hardware")
        except Exception as e:  # pylint: disable=W0718
            self.logger.error("Failed to connect to hardware: %s", e)
            self.error = str(e)
            self.logger.warning("Daemon will start but hardware is not available")

    def _register_sensor_keywords(self):
        """Register one read-only temperature keyword per configured sensor."""
        for entry in self.sensors:
            channel = entry.get("channel")
            keyword = entry.get("keyword")
            if not channel or not keyword:
                self.logger.error("Skipping sensor entry without channel/keyword: %s", entry)
                continue

            self.keyword_registry.float(
                keyword,
                getter=self._make_temperature_getter(channel),
                units=self.units,
                description=f"Temperature at sensor {channel}.")

    def _register_heater_keywords(self):
        """Register the setpoint, output, status and PID keywords per heater."""
        for entry in self.heaters:
            output = entry.get("id")
            keyword = entry.get("keyword")
            if output is None or not keyword:
                self.logger.error("Skipping heater entry without id/keyword: %s", entry)
                continue

            self.keyword_registry.float(
                keyword,
                getter=self._make_output_getter(output),
                units="Amps",
                description=f"Output amps of heater output {output}.")

    def _make_temperature_getter(self, channel):
        """Return a zero-argument getter reading the temperature at `channel`."""
        def getter():
            return self.controller.get_atomic_value(channel)
        return getter

    def _make_output_getter(self, output):
        """Return a zero-argument getter reading the power of heater `output`."""
        def getter():
            return self.controller.get_atomic_value(output)
        return getter

    def on_stop(self, libby=None):
        """Cleanup when the daemon shuts down."""
        self.logger.info("Shutting down %s daemon", self.peer_id)
        if self.controller is None:
            return
        try:
            self.controller.disconnect()
            self.logger.info("Disconnected from SRS PTC10 controller")
        except Exception as e:  # pylint: disable=W0718
            self.logger.error("Error disconnecting: %s", e)
            self.error = str(e)

    def _connect_hardware(self):
        self.logger.info("Connecting to SRS PTC10 controller at %s:%s",
                         self.ip_address, self.tcp_port)
        self.controller.connect(host=self.ip_address, port=int(self.tcp_port))
        if self.controller.is_connected():
            self.controller.initialize()

    def _set_connected(self, value: bool) -> None:
        if value:
            self._connect_hardware()
        else:
            self.controller.disconnect()

    def _error_string(self) -> str:
        """Return last error string"""
        return self.error


def main():
    """Main entry point for the daemon."""
    parser = argparse.ArgumentParser(description='Generic SRS PTC10 Daemon')
    parser.add_argument('-c', '--config', type=str,
                        help='Path to config file (YAML or JSON)')

    args = parser.parse_args()

    if not args.config:
        print("--config is required", file=sys.stderr)
        sys.exit(2)

    try:
        daemon = SRSThermalDaemon.from_config_file(args.config)
        daemon.serve()
    except KeyboardInterrupt:
        print("\nDaemon interrupted by user")
        sys.exit(0)
    except Exception as e:  # pylint: disable=W0718
        print(f"Error running daemon: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()
